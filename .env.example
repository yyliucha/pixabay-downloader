# ============================================
# Pixabay 下载器 - 宿主配置文件模板
# 用法:
#   本地运行:  复制本文件为 .env, 填写 PIXABAY_API_KEY, 然后 python pixabay_downloader.py
#   Docker:    复制本文件为 .env(放在 docker-compose.yml 同目录),
#              填写后执行 docker compose up -d
# ============================================

# ---------- 必填 ----------
# Pixabay API key (注册: https://pixabay.com/accounts/register/ , 在 https://pixabay.com/api/docs/ 查看)
PIXABAY_API_KEY=

# ---------- 下载配置(可选) ----------
# 搜索关键词, 逗号分隔, 每个关键词一个子目录
PIXABAY_KEYWORDS=山,风景,森林,湖泊,自然
# 每个关键词下载多少张(再次运行时 = 还要下载多少张新图)
PIXABAY_COUNT=50
# 图片尺寸: original=原图 / large=大图(约1280px) / webformat=中等(640px) / preview=缩略图(150px)
PIXABAY_SIZE=original
# 图片类型: photo=照片 / illustration=插画 / vector=矢量图 / all=全部
PIXABAY_IMAGE_TYPE=photo
# 安全搜索(过滤不适宜内容): true/false
PIXABAY_SAFE_SEARCH=true
# 并发下载线程数
PIXABAY_WORKERS=4
# 两次搜索请求间隔(秒), 遇到 429 限流时调大
PIXABAY_DELAY=0.2
# 单张图片下载超时(秒)
PIXABAY_TIMEOUT=60

# ---------- Docker 部署配置(可选, 本地运行无需关心) ----------
# 容器时区(定时任务按此时区触发), 如 Asia/Shanghai、UTC
TZ=Asia/Shanghai
# cron 表达式: 分 时 日 月 周; 默认每天 02:00
CRON_EXPRESSION=0 2 * * *
# 容器启动时是否立即执行一次下载(true/false), 首次部署建议先设为 true 验证
RUN_ON_START=false
# 宿主机图片保存目录(相对 docker-compose.yml 所在目录)
PIXABAY_HOST_IMAGES_DIR=./pixabay_images
# 宿主机日志保存目录
PIXABAY_HOST_LOG_DIR=./logs
