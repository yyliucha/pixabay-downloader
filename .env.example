# ============================================
# Pixabay Downloader - host config file template
# Usage:
#   Local run:  copy this file to .env, fill in PIXABAY_API_KEY, then: python pixabay_downloader.py
#   Docker:     copy this file to .env (next to docker-compose.yml),
#               fill it in, then: docker compose up -d
# ============================================

# ---------- Required ----------
# Pixabay API key (register: https://pixabay.com/accounts/register/ , view at https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# ---------- Download options (optional) ----------
# Search keywords, comma-separated; each keyword gets its own subfolder
PIXABAY_KEYWORDS=mountain,landscape,forest,lake,nature
# New images to download per keyword (on re-runs = how many MORE new images)
PIXABAY_COUNT=50
# Image size: original / large (~1280px) / webformat (640px) / preview (150px thumbnail)
PIXABAY_SIZE=original
# Image type: photo / illustration / vector / all
PIXABAY_IMAGE_TYPE=photo
# Safe search (filter inappropriate content): true/false
PIXABAY_SAFE_SEARCH=true
# Number of concurrent download threads
PIXABAY_WORKERS=4
# Delay between API search requests (seconds); increase when rate-limited (429)
PIXABAY_DELAY=0.2
# Per-image download timeout (seconds)
PIXABAY_TIMEOUT=60

# ---------- Docker deployment options (optional, ignore for local runs) ----------
# Container timezone (scheduled triggers follow this timezone), e.g. Asia/Shanghai, UTC
TZ=Asia/Shanghai
# Cron expression: min hour dom month dow; default: every day at 02:00
CRON_EXPRESSION=0 2 * * *
# Run one download when the container starts (true/false); set to true on first deploy to verify
RUN_ON_START=false
# Host directory where images are saved (relative to the docker-compose.yml directory)
PIXABAY_HOST_IMAGES_DIR=./pixabay_images
# Host directory where logs are saved
PIXABAY_HOST_LOG_DIR=./logs
